%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_chess.
%%
%% A chess referee for AI agents on the mesh
%%
%% Scaffolded by `rebar3 new mcl_service' with store=1, then given the four
%% apps the design calls for (mcl_chess boot, play_games CMD, project_games
%% PRJ, query_games QRY), on the mcl-bookclub template.
%%
%% Our libraries float at ~> MAJOR.MINOR (dev rule, 2026-09-30), and every
%% version below is a RELEASED one: no branch, sha or path dependency.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula transitively, and no persistence: mcl_om starts no
    %% reckon-db or evoq application. 1.0 is the macula-15 line, the wire 1.0
    %% the fleet runs since the flag day (2026-10-19).
    {mcl_om, "~> 1.0"},

    %% THIS SERVICE'S OWN EVENT STORE, opened by mcl_chess_app before
    %% mcl_om:boot/1. evoq 1.27.0 is the release this division's two hooks
    %% landed in: an optional handle_info/2 on the process manager instance
    %% (the per-game clock) and new_stream_id/1 (minting a game id).
    {reckon_db,   "~> 5.11"},
    {evoq,        "~> 1.27"},
    {reckon_evoq, "~> 2.8"},

    %% The read model: one sqlite file the PRJ app writes and the QRY app
    %% reads.
    {esqlite, "~> 0.9"}
]}.

%% khepri 0.17 (via reckon_db) uses the deprecated `catch' expression, which
%% warnings_as_errors refuses on OTP 28+.
{overrides, [
    {override, khepri, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

%% THE CHESS RULES NIF IS BUILT WHERE THE CODE IS COMPILED. native/ holds the
%% crate; scripts/build-nif.sh runs cargo and installs the .so into
%% apps/play_games/priv/lib, which relx copies into the release. The hook lives
%% here rather than in a per-app file because this umbrella has none: the app
%% directories carry no rebar.config of their own.
%%
%% On a shared box, cap cargo: `CARGO_BUILD_JOBS=8 rebar3 compile`. The script
%% passes the variable straight through to cargo.
{pre_hooks, [{compile, "bash scripts/build-nif.sh"}]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% A service's handlers implement `macula_response' and call `macula' directly,
%% but macula comes in only through mcl_om, so it is not in the PLT unless it is
%% named here: dialyzer would report every macula call as unknown.
{dialyzer, [{plt_extra_apps, [macula, evoq, reckon_evoq, reckon_db, esqlite]}]}.

{relx, [
    {release, {mcl_chess, "0.7.0"},
     [mcl_chess, play_games, project_games, query_games, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        %% meck stands in for the mesh in the emitter tests: a fact goes out
        %% where the real publish would put it, without a station.
        {deps, [{meck, "~> 1.2"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
