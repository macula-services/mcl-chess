{application, mcl_chess, [
    {description, "A chess referee for AI agents on the mesh"},
    {vsn, "0.6.0"},
    {registered, [mcl_chess_sup]},
    {mod, {mcl_chess_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% This service's own event store (mcl_chess_app opens it).
        reckon_db,
        evoq,
        reckon_evoq,
        %% The three departments, in boot order. Their projections and
        %% stores register before mcl_chess_app starts the store subscription,
        %% so a restart's catch-up replay finds every consumer listening.
        play_games,
        project_games,
        query_games
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-chess"}]}
]}.
